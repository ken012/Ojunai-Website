---
import Logo from '~/components/ui/Logo.astro';
import { products, statusLabel, corporate } from '~/data/products';

const companyLinks = [
  { label: 'About',       href: '/about' },
  { label: 'Careers',     href: '/careers' },
  { label: 'Contact',     href: '/contact' },
];

const legalLinks = [
  { label: 'Terms',    href: '/terms' },
  { label: 'Privacy',  href: '/privacy' },
];

const contactLinks = [
  { label: corporate.contactEmail, href: `mailto:${corporate.contactEmail}` },
  { label: corporate.careersEmail, href: `mailto:${corporate.careersEmail}` },
];
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <Logo size={32} theme="dark" />
      <p><strong>{corporate.name}</strong></p>
      <p class="footer-tag">{corporate.descriptionShort}</p>
      <a href="/products" class="footer-cta">Explore our products →</a>
    </div>

    <div class="footer-links">
      <div class="footer-col">
        <h4>Products</h4>
        {products.map((p) => (
          <a href={p.profileUrl}>
            {p.name}
            {p.status !== 'live' && <span class={`footer-status footer-status-${p.status}`}>{statusLabel(p.status)}</span>}
          </a>
        ))}
      </div>
      <div class="footer-col">
        <h4>Company</h4>
        {companyLinks.map(({ label, href }) => <a href={href}>{label}</a>)}
      </div>
      <div class="footer-col">
        <h4>Legal</h4>
        {legalLinks.map(({ label, href }) => <a href={href}>{label}</a>)}
      </div>
      <div class="footer-col">
        <h4>Contact</h4>
        {contactLinks.map(({ label, href }) => <a href={href}>{label}</a>)}
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <span>© 2026 {corporate.name}. All rights reserved.</span>
      <span class="footer-entity">
        <strong>{corporate.operatingEntity.name}</strong>
        ({corporate.operatingEntity.identifier}) is Ojunai’s Nigerian subsidiary.
      </span>
    </div>
  </div>
</footer>

<style>
  .footer-tag { color: #94A3B8; font-size: 0.9rem; line-height: 1.55; margin-top: 4px; max-width: 320px; }
  .footer-cta {
    display: inline-block;
    margin-top: 14px;
    color: #A5B4FC;
    font-weight: 600;
    text-decoration: none;
    font-size: 0.95rem;
    transition: transform 0.2s, color 0.2s;
  }
  .footer-cta:hover { color: white; transform: translateX(4px); }
  .footer-status {
    display: inline-block;
    margin-left: 8px;
    padding: 1px 6px;
    border-radius: 100px;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    vertical-align: middle;
  }
  .footer-status-early-access { background: rgba(59,130,246,.15); color: #93C5FD; }
  .footer-status-pilot        { background: rgba(167,139,250,.16); color: #C4B5FD; }
  .footer-status-coming-soon  { background: rgba(148,163,184,.15); color: #CBD5E1; }
  .footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .footer-entity { color: #64748B; font-size: 0.82rem; }
  .footer-entity strong { color: #94A3B8; font-weight: 600; }
</style>
