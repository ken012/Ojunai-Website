---
import BaseLayout from '~/components/layout/BaseLayout.astro';
import InterestForm from '~/components/ui/InterestForm.astro';
import { corporate } from '~/data/products';

const title = `Contact — ${corporate.name}`;
const description = `Get in touch with ${corporate.name}. Sales, press, partnerships, careers, and product-specific support.`;

const channels = [
  {
    tag: 'General & press',
    email: corporate.contactEmail,
    body: 'Company inquiries, partnerships, press requests, and anything not covered by the other channels.',
  },
  {
    tag: 'Careers',
    email: corporate.careersEmail,
    body: 'Interested in joining Ojunai Technologies? Send a note with what you build and why.',
    linkLabel: 'See open roles',
    linkHref: '/careers',
  },
];

const productSupport = [
  {
    product: 'Ojunai Inventory',
    profileUrl: '/products/ojunai-inventory',
    supportEmail: 'support@ojunai.com',
    helpUrl: '/products/ojunai-inventory/help',
    note: 'Existing Inventory customers — for the fastest reply, please include your 7-digit account number.',
  },
  {
    product: 'Commerce AI', profileUrl: '/products/commerce-ai', supportEmail: corporate.contactEmail,
    helpUrl: '/products/commerce-ai', note: 'Early-access, platform integration, and product questions.',
  },
  {
    product: 'EV FastRoute', profileUrl: '/products/ev-fastroute', supportEmail: corporate.contactEmail,
    helpUrl: '/products/ev-fastroute', note: 'Launch updates and product questions. Public platform availability is still to be announced.',
  },
  {
    product: 'FlashAppt', profileUrl: '/products/flash-appt', supportEmail: 'hello@flashappt.com',
    helpUrl: 'https://flashappt.com', note: 'Ottawa and Montréal pilot interest for merchants and customers.',
  },
];
---

<BaseLayout title={title} description={description} canonical="/contact">
  <section class="corp-contact-hero">
    <div class="container corp-contact-hero-inner">
      <span class="corp-contact-hero-pill">Contact</span>
      <h1>Get in touch.</h1>
      <p>We're a small, focused team. The right channel gets you the fastest reply.</p>
    </div>
  </section>

  <section class="contact-form-section"><div class="container"><InterestForm product="Ojunai Technologies" recipient={corporate.contactEmail} heading="Send the right details from the start" /></div></section>

  <section class="corp-contact-channels">
    <div class="container">
      <div class="section-header">
        <div class="section-label">Company channels</div>
        <h2>Ojunai Technologies</h2>
      </div>
      <div class="corp-contact-grid">
        {channels.map((c) => (
          <div class="corp-contact-card">
            <div class="corp-contact-tag">{c.tag}</div>
            <a class="corp-contact-email" href={`mailto:${c.email}`}>{c.email}</a>
            <p>{c.body}</p>
            {c.linkHref && (
              <a href={c.linkHref} class="corp-contact-link">{c.linkLabel} →</a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="corp-contact-products">
    <div class="container">
      <div class="section-header">
        <div class="section-label">Product support</div>
        <h2>Support per product.</h2>
        <p>Each product has its own support channels — go directly for the fastest resolution.</p>
      </div>
      <div class="corp-contact-product-grid">
        {productSupport.map((p) => (
          <div class="corp-contact-product-card">
            <a class="corp-contact-product-name" href={p.profileUrl}>{p.product}</a>
            <a class="corp-contact-email" href={`mailto:${p.supportEmail}`}>{p.supportEmail}</a>
            <p>{p.note}</p>
            <a href={p.helpUrl} class="corp-contact-link">Product information →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="corp-contact-legal">
    <div class="container corp-contact-legal-inner">
      <p><strong>{corporate.name}</strong> is the global parent company behind Ojunai’s technology products, including Ojunai Inventory.</p>
      <p><strong>{corporate.operatingEntity.name}</strong> ({corporate.operatingEntity.identifier}) is Ojunai’s Nigerian subsidiary, supporting the group’s operations and customers in Nigeria.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .corp-contact-hero {
    padding: 160px 0 60px;
    background: linear-gradient(180deg, var(--bg-alt) 0%, var(--bg) 100%);
    text-align: center;
  }
  .corp-contact-hero-inner { max-width: 720px; margin: 0 auto; }
  .corp-contact-hero-pill {
    display: inline-block;
    background: var(--brand-light);
    color: var(--brand);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 100px;
    margin-bottom: 20px;
  }
  .corp-contact-hero h1 { font-family: var(--font-display); font-size: clamp(2.2rem, 5vw, 3.2rem); margin-bottom: 12px; }
  .corp-contact-hero p { color: var(--text-2); font-size: 1.1rem; line-height: 1.6; }

  .corp-contact-channels { padding: 80px 0; }
  .contact-form-section { padding: 0 0 80px; background: linear-gradient(180deg, var(--bg), var(--bg-alt)); color: var(--text); }
  .contact-form-section :global(.interest-form) { background: white; border-color: var(--border); box-shadow: var(--shadow); }
  .corp-contact-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  @media (max-width: 760px) { .corp-contact-grid { grid-template-columns: 1fr; } }
  .corp-contact-card {
    background: white; border: 1px solid var(--border); border-radius: 16px;
    padding: 28px;
  }
  .corp-contact-tag {
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--brand); margin-bottom: 10px;
  }
  .corp-contact-email {
    display: inline-block; font-family: var(--font-display); font-size: 1.1rem;
    color: var(--text); font-weight: 600; margin-bottom: 10px;
    text-decoration: none;
  }
  .corp-contact-email:hover { color: var(--brand); }
  .corp-contact-card p { color: var(--text-2); font-size: 0.95rem; line-height: 1.6; margin: 0 0 12px; }
  .corp-contact-link { color: var(--brand); text-decoration: none; font-weight: 600; font-size: 0.9rem; }
  .corp-contact-link:hover { text-decoration: underline; }

  .corp-contact-products { padding: 60px 0; background: var(--bg-alt); }
  .corp-contact-product-grid { display: grid; grid-template-columns: 1fr; gap: 20px; max-width: 720px; margin: 0 auto; }
  .corp-contact-product-card {
    background: white; border: 1px solid var(--border); border-radius: 16px;
    padding: 26px;
  }
  .corp-contact-product-name {
    display: inline-block; font-family: var(--font-display); font-size: 1.1rem;
    color: var(--brand); text-decoration: none; margin-bottom: 8px;
  }
  .corp-contact-product-name:hover { text-decoration: underline; }
  .corp-contact-product-card p { color: var(--text-2); font-size: 0.95rem; line-height: 1.6; margin: 4px 0 12px; }

  .corp-contact-legal { padding: 40px 0 80px; }
  .corp-contact-legal-inner { max-width: 640px; margin: 0 auto; text-align: center; color: var(--text-3); font-size: 0.9rem; }
  .corp-contact-legal p { margin-bottom: 6px; }
  .corp-contact-legal strong { color: var(--text-2); }
</style>
