---
import BaseLayout from '~/components/layout/BaseLayout.astro';
import FlashApptNav from '~/components/ui/FlashApptNav.astro';
const title='FlashAppt for merchants — Recover openings and retain customers';
const description='Review potential calendar openings privately, republish past openings, understand 30-day recovery performance, and turn acquired customers into direct return visits.';
---
<BaseLayout title={title} description={description} canonical="/products/flash-appt/merchant" ogImage="/screenshots/flash-appt/publishable/merchant/merchant-signup-desktop.webp">
  <FlashApptNav />
  <section class="sub-hero"><div class="container"><span>FlashAppt for merchants</span><h1>Recover more of the schedule.</h1><p>Find potential gaps, review every detail before publishing, bring in new customers, and let completed customers return directly to your business.</p><a href="mailto:hello@flashappt.com?subject=FlashAppt%20merchant%20pilot">Join the merchant pilot</a></div></section>
  <section class="content"><div class="container"><header><span>Cancellation recovery</span><h2>Less re-entry. More informed decisions.</h2></header><div class="grid"><article><b>01</b><h3>Private calendar scan</h3><p>Scan a private .ics calendar file to detect potential openings. This is not automatic calendar synchronization and does not connect Google or Outlook accounts automatically.</p></article><article><b>02</b><h3>Review before publishing</h3><p>No calendar event is published automatically. Confirm the service, price, staff member, and time before an opening goes live.</p></article><article><b>03</b><h3>Republish in a few clicks</h3><p>Start from a previously completed, cancelled, or expired opening instead of entering the same details again.</p></article><article><b>04</b><h3>See the 30-day recovery picture</h3><p>Track fill rate, recovered revenue, new customers, repeat customers, favourites, and appointment-watch demand.</p></article></div></div></section>
  <section class="privacy"><div class="container privacy-grid"><div><span>Calendar privacy</span><h2>The scan finds availability, not customer details.</h2></div><div><p>Calendar titles, attendees, notes, locations, and raw identifiers are not uploaded. The merchant remains in control of what becomes a FlashAppt opening.</p><ul><li>No automatic Google or Outlook connection yet</li><li>No automatic event publication</li><li>Merchant review required for service, price, staff, and time</li></ul></div></div></section>
  <section class="relationship"><div class="container"><span>Customer acquisition without lock-in</span><h2>FlashAppt can introduce the customer. You can keep the relationship.</h2><p>After a completed, checked-in FlashAppt visit, the customer can book again directly with the merchant. The repeat relationship belongs to the business.</p></div></section>
  <section class="cta"><div class="container"><h2>Turn the empty hour into a new customer.</h2><a href="/products/flash-appt/faq">Read the FAQ</a></div></section>
</BaseLayout>
<style>
  :global(body){background:#09090b}.sub-hero{padding:110px 0 90px;background:radial-gradient(circle at 78% 20%,rgba(109,40,217,.28),transparent 35%),#09090b;color:#fff}.sub-hero>div{max-width:900px}.sub-hero span,.content header span,.privacy span,.relationship span{color:#a78bfa;font-size:.76rem;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.sub-hero h1,.content h2,.privacy h2,.relationship h2,.cta h2{font-family:var(--font-display);letter-spacing:-.045em}.sub-hero h1{font-size:clamp(3rem,7vw,6rem);line-height:.98;margin:16px 0}.sub-hero p{color:#aaaab4;font-size:1.15rem;line-height:1.7;max-width:720px}.sub-hero a,.cta a{display:inline-block;margin-top:25px;padding:13px 22px;border-radius:999px;background:linear-gradient(135deg,#6d28d9,#4f46e5);color:#fff;text-decoration:none;font-weight:800}.content,.privacy,.relationship{padding:90px 0;color:#fff}.content{background:#101012}.content h2,.privacy h2,.relationship h2,.cta h2{font-size:clamp(2.2rem,4vw,3.7rem);line-height:1.05;margin:12px 0 28px}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}.grid article{padding:25px;border:1px solid #2b2b31;border-radius:20px;background:#18181b}.grid b{color:#a78bfa}.grid h3{font-size:1.35rem;margin:12px 0 7px}.grid p,.privacy p,.privacy li,.relationship p{color:#a1a1aa;line-height:1.7}.privacy{background:#09090b}.privacy-grid{display:grid;grid-template-columns:1fr 1fr;gap:70px}.privacy ul{padding-left:20px;margin-top:18px}.relationship{background:#101012;text-align:center}.relationship>div{max-width:820px}.relationship p{font-size:1.05rem}.cta{text-align:center;padding:80px 0;background:#130d22;color:#fff}@media(max-width:700px){.grid,.privacy-grid{grid-template-columns:1fr}.sub-hero{padding:85px 0 70px}.content,.privacy,.relationship{padding:65px 0}}
</style>
