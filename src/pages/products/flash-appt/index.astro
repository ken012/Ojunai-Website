---
import BaseLayout from '~/components/layout/BaseLayout.astro';
import InterestForm from '~/components/ui/InterestForm.astro';
import FlashApptNav from '~/components/ui/FlashApptNav.astro';
const title='FlashAppt — Recover cancellations and bring customers back';
const description='FlashAppt helps merchants fill last-minute openings, understand demand, and retain customers while consumers discover, watch, save, refer, and book again.';
const productSchema={'@context':'https://schema.org','@type':'WebApplication',name:'FlashAppt',applicationCategory:'LifestyleApplication',operatingSystem:'Web, iOS',description,url:'https://ojunai.com/products/flash-appt',offers:{'@type':'Offer',availability:'https://schema.org/PreOrder'}};
const merchantShots=[
  ['/screenshots/flash-appt/publishable/merchant/merchant-signup-desktop.webp','Merchant onboarding','Businesses apply, confirm their service location, category, and operating details.'],
  ['/screenshots/flash-appt/publishable/merchant/check-in.webp','Secure customer check-in','Scan a signed QR pass or verify it manually at arrival.'],
];
const consumerShots=[
  ['/screenshots/flash-appt/publishable/consumer/consumer-marketplace-desktop.webp','Live appointment discovery','Filter nearby openings by category, distance, price, and availability.'],
  ['/screenshots/flash-appt/publishable/consumer/alerts.webp','Opening alerts','Choose where and what to watch. Alerts improve discovery but do not reserve or guarantee an appointment.'],
];
---
<BaseLayout title={title} description={description} canonical="/products/flash-appt" ogImage="/screenshots/flash-appt/publishable/consumer/consumer-marketplace-desktop.webp" jsonLd={productSchema}>
  <FlashApptNav />
  <section class="fa-hero"><div class="container hero-grid"><div>
    <nav class="crumb" aria-label="Breadcrumb"><a href="/products">Products</a><span>›</span><span>FlashAppt</span></nav>
    <img src="/brand/flashappt-mark-192.png" alt="FlashAppt mark" class="mark" width="84" height="84">
    <div class="badge">Appointments marketplace · Pilot</div>
    <h1>Recover the cancellation. <em>Keep the customer.</em></h1>
    <p>FlashAppt helps businesses turn last-minute availability into new customers—and gives completed customers a direct route back to the merchant. Consumers can find nearby openings, save favourites, create appointment watches, and book again.</p>
    <div class="actions"><a class="primary" href="mailto:hello@flashappt.com">Join the pilot</a><a href="#whats-new">See what’s new →</a></div>
    <div class="pilot">Ottawa & Montréal pilot</div>
  </div><img class="hero-shot" src="/screenshots/flash-appt/publishable/consumer/consumer-marketplace-mobile.webp" alt="FlashAppt consumer marketplace on mobile" width="424" height="919"></div></section>

  <section class="section flow"><div class="container"><div class="kicker">From opening to repeat customer</div><h2>Recover revenue without owning the relationship.</h2><div class="steps"><article><b>01</b><h3>Spot an opening</h3><p>Publish an opening manually, republish a previous one, or use a private calendar scan to identify a time worth reviewing.</p></article><article><b>02</b><h3>Reach nearby demand</h3><p>The marketplace, favourites, and appointment watches help relevant customers discover it. Alerts never reserve or guarantee a booking.</p></article><article><b>03</b><h3>Confirm the visit</h3><p>The customer reserves securely and presents a signed QR pass when they arrive.</p></article><article><b>04</b><h3>Build the relationship</h3><p>After a completed checked-in visit, the customer can book again directly with the merchant.</p></article></div></div></section>

  <section class="section new" id="whats-new"><div class="container"><div class="kicker">New across web and iOS</div><h2>More ways to find demand—and turn a first visit into the next one.</h2><div class="audience-grid"><article><span>For consumers</span><h3>Remember the businesses you love.</h3><ul><li>Save favourite businesses and receive priority opening alerts</li><li>Create appointment watches by service, category, price, day, and time</li><li>Discover openings matched to your preferences</li><li>Book again directly with a merchant after a completed, checked-in FlashAppt visit</li></ul><a href="/products/flash-appt/consumer">Explore the consumer experience →</a></article><article><span>For merchants</span><h3>Recover more of the schedule.</h3><ul><li>Detect potential openings using a private .ics calendar scan</li><li>Review the service, price, staff, and time before anything is published</li><li>Republish completed, cancelled, or expired openings in a few clicks</li><li>Measure 30-day fill rate, recovered revenue, customer mix, favourites, and appointment-watch demand</li></ul><a href="/products/flash-appt/merchant">Explore merchant recovery tools →</a></article></div><p class="release-note">New feature screenshots will be added after the release is deployed.</p></div></section>

  <section class="section privacy"><div class="container privacy-grid"><div class="privacy-copy"><div class="kicker">Private calendar scan</div><h2>Your calendar details stay private.</h2><p>Choose an <code>.ics</code> calendar file and FlashAppt checks it for possible openings—not customer or appointment details. Nothing goes live automatically, and Google or Outlook accounts do not connect automatically yet.</p><div class="review-note"><span aria-hidden="true">✓</span><div><strong>You stay in control</strong><small>Review the service, price, staff member, and time before publishing any opening.</small></div></div></div><div class="privacy-panel"><div class="panel-heading"><span class="shield" aria-hidden="true">◇</span><div><strong>Protected calendar details</strong><small>These fields are not uploaded</small></div></div><div class="privacy-cards"><article><span aria-hidden="true">Aa</span><div><strong>Event titles</strong><small>Appointment names remain private</small></div></article><article><span aria-hidden="true">◎</span><div><strong>Attendees</strong><small>Customer identities stay private</small></div></article><article><span aria-hidden="true">≡</span><div><strong>Notes</strong><small>Event descriptions are excluded</small></div></article><article><span aria-hidden="true">⌖</span><div><strong>Locations</strong><small>Calendar locations are excluded</small></div></article><article><span aria-hidden="true">#</span><div><strong>Raw identifiers</strong><small>Internal calendar IDs are excluded</small></div></article><article class="control-card"><span aria-hidden="true">✓</span><div><strong>Merchant approval</strong><small>Required before publication</small></div></article></div></div></div></section>

  <section class="section screens"><div class="container"><div class="kicker">Current product screens</div><h2>See FlashAppt from both sides.</h2><p class="intro">These screens show the current published experience. New retention and cancellation-recovery screenshots will follow after deployment.</p><h3 class="group-title">Consumer experience</h3><div class="screen-grid">{consumerShots.map(([src,name,text])=><figure><img src={src} alt={`FlashAppt ${name}`} loading="lazy"><figcaption><strong>{name}</strong><span>{text}</span><small>Actual product screen</small></figcaption></figure>)}</div><h3 class="group-title">Merchant experience</h3><div class="screen-grid">{merchantShots.map(([src,name,text])=><figure><img src={src} alt={`FlashAppt ${name}`} loading="lazy"><figcaption><strong>{name}</strong><span>{text}</span><small>Actual product screen</small></figcaption></figure>)}</div></div></section>

  <section class="section trust"><div class="container trust-grid"><div><div class="kicker">Clear by design</div><h2>Specific about alerts, calendars, check-in, and payments.</h2></div><div class="checks"><span>✓ Alerts do not reserve appointments</span><span>✓ Merchant review before publishing</span><span>✓ Calendar details stay private</span><span>✓ Direct rebooking stays with the merchant</span><span>✓ Signed QR check-in passes</span><span>✓ Stripe payment processing</span></div></div></section>
  <section class="final"><div class="container"><h2>Fill the opening. Earn the return visit.</h2><p>FlashAppt is preparing its Ottawa and Montréal pilot.</p><div class="final-links"><a href="/products/flash-appt/faq">Read the FAQ</a><a href="/privacy#flashappt">Privacy</a><a href="/terms#flashappt">Terms</a></div><InterestForm product="FlashAppt" recipient="hello@flashappt.com" heading="Join the FlashAppt pilot" /></div></section>
</BaseLayout>
<style>
  :global(body){background:#09090b}.fa-hero{padding:72px 0 88px;background:radial-gradient(circle at 75% 22%,rgba(109,40,217,.28),transparent 34%),#09090b;color:#fafafa}.hero-grid{display:grid;grid-template-columns:1.12fr .88fr;gap:70px;align-items:center}.crumb{display:flex;gap:8px;color:#77778a;font-size:.82rem;margin-bottom:26px}.crumb a{color:inherit}.mark{border-radius:22px}.badge,.pilot{display:inline-flex;margin-top:18px;border:1px solid rgba(129,140,248,.35);background:rgba(129,140,248,.1);color:#a5b4fc;padding:7px 12px;border-radius:999px;font-size:.76rem;font-weight:700}.fa-hero h1,.section h2,.final h2{font-family:var(--font-display);letter-spacing:-.04em}.fa-hero h1{font-size:clamp(3rem,6vw,5.7rem);line-height:.98;margin:20px 0}.fa-hero h1 em{font-style:normal;color:#8b5cf6}.fa-hero p{font-size:1.12rem;color:#aaaab4;line-height:1.7;max-width:720px}.actions{display:flex;gap:20px;align-items:center;margin:30px 0 0}.actions a{color:#c4b5fd;text-decoration:none;font-weight:700}.primary{display:inline-block!important;background:linear-gradient(135deg,#6d28d9,#4f46e5);color:#fff!important;padding:14px 25px;border-radius:999px;text-decoration:none;font-weight:800;box-shadow:0 14px 35px rgba(109,40,217,.28)}.hero-shot{display:block;max-height:700px;width:auto;max-width:100%;margin:auto;border-radius:28px;box-shadow:0 35px 90px rgba(0,0,0,.5)}.section{padding:88px 0;background:#101012;color:#fafafa}.section:nth-of-type(odd){background:#09090b}.kicker{font-size:.76rem;text-transform:uppercase;letter-spacing:.14em;font-weight:800;color:#a78bfa}.section h2{font-size:clamp(2.2rem,4vw,3.7rem);max-width:880px;margin:12px 0 22px}.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:38px}.steps article,.audience-grid article{padding:24px;border:1px solid #29292e;border-radius:20px;background:#18181b}.steps b{color:#a78bfa}.steps h3{margin:14px 0 8px}.steps p,.privacy p{color:#a1a1aa;line-height:1.65}.audience-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:38px}.audience-grid article>span{color:#a78bfa;font-size:.75rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em}.audience-grid h3{font-size:1.5rem;margin:12px 0}.audience-grid ul{padding-left:20px;color:#b4b4bd;line-height:1.7}.audience-grid li+li{margin-top:8px}.audience-grid a{display:inline-block;color:#c4b5fd;text-decoration:none;font-weight:800;margin-top:20px}.release-note{color:#71717a;margin-top:20px;font-size:.86rem}.privacy-grid,.trust-grid{display:grid;grid-template-columns:1fr 1fr;gap:50px}.checks{display:grid;grid-template-columns:1fr 1fr;gap:12px}.checks span{padding:15px;background:#18181b;border:1px solid #313138;border-radius:14px;color:#ddd6fe;font-weight:700}.screens{background:#0b0b0e}.intro{color:#a1a1aa;max-width:780px;line-height:1.7}.group-title{margin:44px 0 18px;font-size:1.35rem}.screen-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}.screen-grid figure{margin:0;border:1px solid #2c2c34;border-radius:22px;overflow:hidden;background:#18181b}.screen-grid img{width:100%;display:block;aspect-ratio:16/9;object-fit:cover;object-position:top}.screen-grid figcaption{padding:20px}.screen-grid strong,.screen-grid span,.screen-grid small{display:block}.screen-grid span{color:#a1a1aa;margin:7px 0;line-height:1.5}.screen-grid small{color:#a78bfa}.final{text-align:center;padding:86px 0;background:linear-gradient(180deg,#130d22,#09090b);color:#fff}.final h2{font-size:clamp(2.2rem,4vw,3.7rem)}.final>div>p{color:#aaaab4;margin:10px 0 18px}.final-links{display:flex;justify-content:center;gap:18px;flex-wrap:wrap}.final-links a{color:#c4b5fd;text-decoration:none;font-weight:700}@media(max-width:900px){.hero-grid,.privacy-grid,.trust-grid{grid-template-columns:1fr}.steps{grid-template-columns:repeat(2,1fr)}}@media(max-width:650px){.steps,.audience-grid,.screen-grid,.checks{grid-template-columns:1fr}.section{padding:64px 0}.actions{align-items:flex-start;flex-direction:column}.screen-grid img{aspect-ratio:auto}}
  .privacy-copy code{font:inherit;color:#ddd6fe}.review-note{display:flex;gap:13px;align-items:flex-start;margin-top:28px;padding:17px 18px;border:1px solid rgba(139,92,246,.32);border-radius:16px;background:rgba(109,40,217,.1)}.review-note>span{display:grid;place-items:center;flex:0 0 27px;height:27px;border-radius:50%;background:#7c3aed;color:#fff;font-weight:900}.review-note strong,.review-note small,.panel-heading strong,.panel-heading small,.privacy-cards strong,.privacy-cards small{display:block}.review-note small,.panel-heading small,.privacy-cards small{color:#92929d;line-height:1.45}.privacy-panel{padding:22px;border:1px solid #303038;border-radius:24px;background:linear-gradient(145deg,#1a1a1e,#121216);box-shadow:0 24px 70px rgba(0,0,0,.24)}.panel-heading{display:flex;align-items:center;gap:13px;padding:3px 3px 19px}.shield{display:grid;place-items:center;width:39px;height:39px;border-radius:12px;background:linear-gradient(135deg,#7c3aed,#4f46e5);font-size:1.35rem}.privacy-cards{display:grid;grid-template-columns:1fr 1fr;gap:10px}.privacy-cards article{display:flex;gap:12px;align-items:center;min-height:84px;padding:14px;border:1px solid #292930;border-radius:15px;background:#0f0f12}.privacy-cards article>span{display:grid;place-items:center;flex:0 0 34px;height:34px;border-radius:10px;background:#222228;color:#c4b5fd;font-size:.78rem;font-weight:900}.privacy-cards .control-card{border-color:rgba(124,58,237,.36);background:rgba(109,40,217,.1)}.privacy-cards .control-card>span{background:#7c3aed;color:#fff}@media(max-width:650px){.privacy-cards{grid-template-columns:1fr}.privacy-panel{padding:16px}}
</style>
