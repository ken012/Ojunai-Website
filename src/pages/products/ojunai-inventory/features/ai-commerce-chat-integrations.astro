  <script is:inline>
    // Chat demo carousel — auto-plays every 6s, pauses on hover, keyboard-navigable.
    (function () {
      const stage = document.querySelector('.ci-demo');
      if (!stage) return;
      const tabs = stage.querySelectorAll('.ci-demo-tab');
      const panels = stage.querySelectorAll('.ci-demo-panel');
      const dots = stage.querySelectorAll('.ci-demo-dot');
      const prev = stage.querySelector('[data-demo-prev]');
      const next = stage.querySelector('[data-demo-next]');
      let idx = 0;
      let timer = null;
      const AUTOPLAY_MS = 6000;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function show(i) {
        idx = (i + panels.length) % panels.length;
        tabs.forEach((t, n) => {
          t.classList.toggle('ci-demo-tab-active', n === idx);
          t.setAttribute('aria-selected', n === idx ? 'true' : 'false');
        });
        panels.forEach((p, n) => {
          p.classList.toggle('ci-demo-panel-active', n === idx);
          if (n === idx) p.removeAttribute('hidden');
          else p.setAttribute('hidden', '');
        });
        dots.forEach((d, n) => d.classList.toggle('ci-demo-dot-active', n === idx));
      }
      function play() {
        if (reduce) return;
        stop();
        timer = setInterval(() => show(idx + 1), AUTOPLAY_MS);
      }
      function stop() { if (timer) { clearInterval(timer); timer = null; } }

      tabs.forEach((t) => t.addEventListener('click', () => { show(+t.dataset.demoTab); stop(); }));
      dots.forEach((d) => d.addEventListener('click', () => { show(+d.dataset.demoDot); stop(); }));
      if (prev) prev.addEventListener('click', () => { show(idx - 1); stop(); });
      if (next) next.addEventListener('click', () => { show(idx + 1); stop(); });

      stage.addEventListener('mouseenter', stop);
      stage.addEventListener('mouseleave', play);
      stage.addEventListener('focusin', stop);
      stage.addEventListener('focusout', (ev) => {
        if (!stage.contains(ev.relatedTarget)) play();
      });
      stage.addEventListener('keydown', (ev) => {
        if (ev.key === 'ArrowLeft')  { show(idx - 1); stop(); ev.preventDefault(); }
        if (ev.key === 'ArrowRight') { show(idx + 1); stop(); ev.preventDefault(); }
      });

      play();
    })();

    // Try-a-prompt widget
    (function () {
      const bubbles = document.getElementById('ci-tryprompt-bubbles');
      if (!bubbles) return;
      document.querySelectorAll('.ci-tryprompt-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const prompt = btn.dataset.prompt;
          const reply = btn.dataset.reply;
          bubbles.innerHTML = '';
          const now = new Date().toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
          const out = document.createElement('div');
          out.className = 'ci-bubble ci-bubble-out';
          out.innerHTML = escapeHtml(prompt) + '<span class="ci-time">' + now + '</span>';
          bubbles.appendChild(out);
          const typing = document.createElement('div');
          typing.className = 'ci-bubble ci-bubble-in ci-typing';
          typing.innerHTML = '<span class="ci-typing-dot"></span><span class="ci-typing-dot"></span><span class="ci-typing-dot"></span>';
          bubbles.appendChild(typing);
          setTimeout(() => {
            typing.remove();
            const inb = document.createElement('div');
            inb.className = 'ci-bubble ci-bubble-in';
            inb.innerHTML = escapeHtml(reply).replace(/\n/g, '<br>') + '<span class="ci-time">' + now + ' ✓✓</span>';
            bubbles.appendChild(inb);
          }, 800);
        });
      });
      function escapeHtml(s) { return String(s).replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
    })();

    // Request-integration form
    function handleIntRequest(ev) {
      ev.preventDefault();
      const form = ev.target;
      const platform = form.platform.value.trim();
      const email = form.email.value.trim();
      const subject = encodeURIComponent('Request an integration: ' + platform);
      const body = encodeURIComponent('Platform: ' + platform + '\nFrom: ' + email + '\n\nAny extra context?');
      window.location.href = 'mailto:contact@ojunai.com?subject=' + subject + '&body=' + body;
      form.querySelector('.ci-request-thanks').hidden = false;
      return false;
    }
  </script>
