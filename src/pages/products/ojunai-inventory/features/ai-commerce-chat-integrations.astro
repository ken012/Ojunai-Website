---
import BaseLayout from '~/components/layout/BaseLayout.astro';
import FinalCTA from '~/components/sections/FinalCTA.astro';

// ============================================================================
// AI Commerce Chat Integrations — dedicated Features sub-page.
// URL: /features/ai-commerce-chat-integrations
// Nav label: "AI Commerce Chat Integrations"
// ============================================================================

const WHATSAPP_STATUS = 'Live';

// ---------- Integrations (Group 1: commerce; Group 2: channels) ----------
const commerceIntegrations = [
  {
    id: 'shopify',
    name: 'Shopify',
    blurb: 'Full commerce ops: orders, inventory, products, customers, discounts, fulfillment.',
    status: 'Live',
    accent: '#5D8A3A',
    iconBg: 'linear-gradient(135deg,#95BF47,#5D8A3A)',
    letter: 'S',
    capabilities: [
      'Read: sales, orders, customers, inventory, products, discounts',
      'Write: create/update products, adjust inventory, refund orders, fulfill orders, apply discounts',
      'Proactive alerts: low stock, unfulfilled orders, sales drops',
      'Purchase-order workflow with supplier tracking',
      'Reorder forecasting from velocity × lead time',
    ],
  },
  {
    id: 'woocommerce',
    name: 'WooCommerce',
    blurb: 'Self-hosted WordPress stores, same conversational control.',
    status: 'Live',
    accent: '#7F54B3',
    iconBg: 'linear-gradient(135deg,#96588A,#7F54B3)',
    letter: 'W',
    capabilities: [
      'Read: sales, orders, customers, inventory, products, coupons',
      'Write: create/update products, adjust inventory, refund orders, mark orders complete, create coupons',
      'Proactive alerts on stock and order flow',
      'Purchase-order workflow with supplier tracking',
      'Reorder forecasting from velocity × lead time',
    ],
  },
  {
    id: 'paystack',
    name: 'Paystack',
    blurb: 'Payments-first — transactions & customer insights at a glance.',
    status: 'Live',
    accent: '#00C3F7',
    iconBg: 'linear-gradient(135deg,#0BA4E0,#00C3F7)',
    letter: 'P',
    capabilities: [
      'Read: transactions, customers, subscription status, settlements',
      'Analytics: revenue trends, top customers, refund rates',
      'Proactive alerts on failed payments and chargebacks',
      'No inventory or discount management (payments platform)',
    ],
  },
  {
    id: 'flutterwave',
    name: 'Flutterwave',
    blurb: 'Payments-first — transactions and revenue tracking on demand.',
    status: 'Live',
    accent: '#F5A623',
    iconBg: 'linear-gradient(135deg,#F58231,#F5A623)',
    letter: 'F',
    capabilities: [
      'Read: transactions, customers, settlement balances',
      'Analytics: revenue trends, cross-currency reporting',
      'Proactive alerts on failed transactions and disputes',
      'No inventory or discount management (payments platform)',
    ],
  },
];

const channelIntegrations = [
  {
    id: 'telegram',
    name: 'Telegram',
    blurb: 'Full assistant: text, voice notes, and photos.',
    status: 'Live',
    accent: '#229ED9',
    iconBg: 'linear-gradient(135deg,#37AEE2,#229ED9)',
    letter: 'T',
    capabilities: [
      'Text, voice notes, and photo attachments all supported',
      'Multi-store switching from a single chat',
      'Group chats supported for team access with role-based permissions',
      'Bot inline commands + natural language',
    ],
  },
  {
    id: 'whatsapp',
    name: 'WhatsApp',
    blurb: 'The same assistant on the world\'s most-used chat app.',
    status: WHATSAPP_STATUS,
    accent: '#25D366',
    iconBg: 'linear-gradient(135deg,#25D366,#128C7E)',
    letter: 'W',
    capabilities: [
      'Text, voice notes, and photo attachments all supported',
      'Business number verified per store',
      'Native WhatsApp business features (labels, catalog sync where applicable)',
      'Multi-store switching from a single chat',
    ],
  },
];

// ---------- Capability pillars (4) ----------
const pillars = [
  {
    title: 'Ask anything about your store',
    iconPath: 'M11 3a8 8 0 015.4 13.9l3.7 3.7-1.4 1.4-3.7-3.7A8 8 0 1111 3zm0 2a6 6 0 100 12 6 6 0 000-12z',
    examples: [
      '"What sold today?"',
      '"Top customers this month"',
      '"Which orders are unfulfilled?"',
      '"Why are sales down this week?"',
    ],
  },
  {
    title: 'Run it by text or voice',
    iconPath: 'M12 2a3 3 0 013 3v6a3 3 0 01-6 0V5a3 3 0 013-3zm7 9a7 7 0 01-14 0h2a5 5 0 0010 0h2zM11 21v-2h2v2h-2z',
    examples: [
      '"Add 20 to Blue Jeans"',
      '"10% off all hoodies until Friday"',
      '"Refund order #1043"',
      '"Fulfill #1050"',
    ],
    note: 'Every change asks you to confirm before it happens.',
  },
  {
    title: 'Inventory command center',
    iconPath: 'M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4H6zM3 6h18M16 10a4 4 0 01-8 0',
    examples: [
      '"Show low stock"',
      '"Create a PO to Acme for 50 hoodies"',
      '"Receive PO #12"',
      '"What should I reorder?"',
      '"What\'s my inventory worth?"',
    ],
  },
  {
    title: 'Smart & proactive',
    iconPath: 'M13 2L3 14h9l-1 8 10-12h-9l1-8z',
    examples: [
      'Multilingual replies (English, French, Mandarin, Spanish and more)',
      'Remembers your preferences',
      'Alerts you BEFORE you run out',
      'Reads voice notes, product photos, supplier invoices',
      'Switch between multiple stores on command',
    ],
  },
];

// ---------- Chat scripts (auto-playing carousel) ----------
const chatScripts = [
  {
    title: 'Instant answers',
    bubbles: [
      { role: 'user',      text: 'what sold today?', time: '9:14 AM' },
      { role: 'assistant', text: 'Today: 42 orders, $3,180 in sales — up 12% vs yesterday. Top seller: Premium Grey Hoodie (18 units).', time: '9:14 AM' },
    ],
  },
  {
    title: 'Reorder forecasting → one-tap PO',
    bubbles: [
      { role: 'user',      text: 'what should I reorder?', time: '10:02 AM' },
      { role: 'assistant', text: 'Reorder suggestions (30-day sales, 7-day lead):\n\n• Black Crew Tee — 6 on hand, ~3/day, ~2 days left → order 40\n• Denim Jacket — 4 on hand → order 15\n\nReply YES to draft a purchase order.', time: '10:02 AM' },
      { role: 'user',      text: 'yes', time: '10:02 AM' },
      { role: 'assistant', text: 'Created PO #7 (draft) — 2 lines, 55 units.', time: '10:02 AM' },
    ],
  },
  {
    title: 'Voice note',
    bubbles: [
      { role: 'user',      text: '🎤 Voice message · 0:04', voice: true, transcript: 'restock everything that\'s low to fifty', time: '11:30 AM' },
      { role: 'assistant', text: 'Restock 8 low-stock items to 50 each. Reply YES to apply.', time: '11:30 AM' },
    ],
  },
  {
    title: 'Snap a supplier invoice',
    bubbles: [
      { role: 'user',      text: '📷 Photo · delivery-invoice.jpg', photo: true, time: '2:47 PM' },
      { role: 'assistant', text: 'I read 6 items on that invoice. Want me to add them to stock? Reply YES.', time: '2:47 PM' },
    ],
  },
  {
    title: 'Speaks your language',
    bubbles: [
      { role: 'user',      text: 'quelles sont mes ventes aujourd\'hui ?', time: '9:15 AM' },
      { role: 'assistant', text: 'Aujourd\'hui : 42 commandes, 3 180 $ de ventes.', time: '9:15 AM' },
    ],
  },
  {
    title: 'Proactive alert',
    bubbles: [
      { role: 'assistant', text: 'Heads-up: Black Tee is down to 3 units — about 2 days left at current sales. Want me to draft a reorder?', time: '4:12 PM', proactive: true },
    ],
  },
  {
    title: 'Many stores, one chat',
    bubbles: [
      { role: 'user',      text: 'switch to my Shopify store', time: '8:04 AM' },
      { role: 'assistant', text: 'Now managing "Downtown Threads" (Shopify). Ask away.', time: '8:04 AM' },
    ],
  },
];

// ---------- Try-a-prompt widget (canned prompts + replies) ----------
const cannedPrompts = [
  { prompt: 'What sold today?',            reply: 'Today: 42 orders, $3,180 in sales — up 12% vs yesterday. Top seller: Premium Grey Hoodie (18 units).' },
  { prompt: 'Show low stock',              reply: '8 items below reorder point:\n\n• Black Crew Tee — 6 (target 20)\n• Denim Jacket — 4 (target 15)\n• Grey Beanie — 3 (target 10)\n\nWant me to draft a PO?' },
  { prompt: "What's my inventory worth?",  reply: '$47,820 at cost across 312 SKUs. Top valuation category: Outerwear ($18,200).' },
  { prompt: 'Refund order #1043',           reply: 'Order #1043 — Sarah Chen · Premium Hoodie · $89.\n\nReply CONFIRM to issue full refund via Shopify.' },
];

// ---------- Differentiator block ----------
const differentiators = [
  {
    title: 'Purchase orders & suppliers',
    body: 'Create, edit, receive, and track POs — all by chat. Supplier records live in the assistant\'s memory.',
    iconPath: 'M9 11l3 3 8-8M6 12l3 3 8-8M3 13l3 3 8-8',
  },
  {
    title: 'Reorder forecasting',
    body: 'velocity × lead time − on-hand − on-order. The math you should be doing, done for you every morning.',
    iconPath: 'M3 3v18h18M7 15l4-4 4 4 5-5',
  },
  {
    title: 'Cost, margins & valuation',
    body: '"What\'s my margin on X?" and "What\'s my inventory worth?" get real answers, not a dashboard link.',
    iconPath: 'M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6',
  },
];

// ---------- How it works (3 steps) ----------
const howSteps = [
  { n: '01', title: 'Connect your platform', body: 'A couple of clicks. Secure OAuth for Shopify and WooCommerce; API keys for Paystack and Flutterwave. Nothing to install.' },
  { n: '02', title: 'Add your team on WhatsApp or Telegram', body: 'Share a link code with each teammate. Assign a role — Owner, Manager, Support, or Read-only.' },
  { n: '03', title: 'Just ask', body: 'Text, talk, or snap a photo. Every write action asks you to confirm before it happens.' },
];

// ---------- Trust & security bullets ----------
const trustBullets = [
  { title: 'AES-256-GCM encryption at rest', body: 'Every store credential and API key encrypted per-merchant. Keys rotated on schedule.' },
  { title: 'Confirm-before-change on every write', body: 'Bulk or irreversible actions require an explicit CONFIRM reply — never an assumed action.' },
  { title: 'Role-based access',                body: 'Owner / Manager / Support / Read-only roles. Each role gets exactly what it needs — no more.' },
  { title: 'Per-store isolation',              body: 'Data never crosses between merchants. Multi-tenant boundaries enforced at the database layer.' },
];

// ---------- Pricing teaser ----------
const pricingTeaserRows = [
  { name: 'Starter',  price: 'Free',        blurb: 'Try the assistant — read-only queries, 1 store, 15 actions/month.' },
  { name: 'Pro',      price: 'From $69.99', blurb: 'Full write access, reorder forecasting, purchase orders, analytics, multi-store.', featured: true },
  { name: 'Scale',    price: 'From $149.99',blurb: 'Multi-user roles, unlimited chat quotas, advanced automation and audit logs.' },
];

// ---------- Comparison strip ----------
const comparisonRows = [
  { concern: 'How you use it',       dashOnly: 'Log in, click through dashboards',        ojunai: 'Just text or talk on WhatsApp / Telegram' },
  { concern: 'Getting insights',      dashOnly: 'Pull reports manually',                   ojunai: 'Proactive alerts before problems bite' },
  { concern: 'Multi-store',           dashOnly: 'Log in and out of each store',            ojunai: '"Switch to store X" — one chat, all stores' },
  { concern: 'Platform coverage',     dashOnly: 'One tool per platform',                   ojunai: 'Shopify, WooCommerce, Paystack, Flutterwave — one assistant' },
  { concern: 'Mobile use',            dashOnly: 'Cramped dashboard on 5" screen',          ojunai: 'Chat is native to mobile' },
];

// ---------- Capability matrix (per platform) ----------
const matrixHeaders = ['Capability', 'Shopify', 'WooCommerce', 'Paystack', 'Flutterwave'];
const matrixRows = [
  { cap: 'Read sales & orders',    cells: ['✓', '✓', '✓', '✓'] },
  { cap: 'Read customers',          cells: ['✓', '✓', '✓', '✓'] },
  { cap: 'Read inventory',          cells: ['✓', '✓', '—', '—'] },
  { cap: 'Update products',         cells: ['✓', '✓', '—', '—'] },
  { cap: 'Adjust inventory',        cells: ['✓', '✓', '—', '—'] },
  { cap: 'Refund orders',           cells: ['✓', '✓', '—', '—'] },
  { cap: 'Fulfill orders',          cells: ['✓', '✓', '—', '—'] },
  { cap: 'Create discounts',        cells: ['✓', '✓', '—', '—'] },
  { cap: 'Purchase orders',         cells: ['✓', '✓', '—', '—'] },
  { cap: 'Payment analytics',       cells: ['✓', '✓', '✓', '✓'] },
  { cap: 'Refund/settlement alerts',cells: ['✓', '✓', '✓', '✓'] },
];

// ---------- Persona cards ----------
const personas = [
  {
    tag: 'Shopify merchant',
    love: 'Reorder forecasting that actually accounts for lead time — no more running out of best-sellers on weekends.',
    iconPath: 'M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4H6zM3 6h18M16 10a4 4 0 01-8 0',
    accent: '#5D8A3A',
  },
  {
    tag: 'WooCommerce store owner',
    love: 'Runs on WordPress hosting you already have. No new dashboard to babysit — the chat is the interface.',
    iconPath: 'M4 4h16v4H4zM4 12h16v8H4z',
    accent: '#7F54B3',
  },
  {
    tag: 'Payments merchant',
    love: 'Revenue trends and refund/chargeback alerts land in chat — no more logging in to check settlement balances.',
    iconPath: 'M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6',
    accent: '#00C3F7',
  },
];

// ---------- FAQ ----------
const faqs = [
  {
    q: 'Which platforms do you support?',
    a: 'Shopify and WooCommerce for full commerce operations (products, inventory, orders, discounts, fulfillment). Paystack and Flutterwave for payments and revenue analytics. Chat channels: Telegram and WhatsApp, both Live. If you use something else, tell us via the "Request an integration" tile above and we\'ll prioritize based on demand.',
  },
  {
    q: 'Do I need to install anything?',
    a: 'No. Connect via OAuth (Shopify, WooCommerce) or API keys (Paystack, Flutterwave). Message the assistant on WhatsApp or Telegram — no app to download.',
  },
  {
    q: 'Is WhatsApp available?',
    a: `WhatsApp is ${WHATSAPP_STATUS}. Every capability that works on Telegram works on WhatsApp — text, voice notes, and photo attachments.`,
  },
  {
    q: 'Is it safe to connect my store?',
    a: 'Store credentials are encrypted at rest with AES-256-GCM. Every write action asks you to confirm before it happens. Bulk or irreversible actions require an explicit CONFIRM. Data is isolated per merchant — nothing crosses between stores.',
  },
  {
    q: 'Can my team use it too?',
    a: 'Yes. Add teammates with a link code and assign a role — Owner, Manager, Support, or Read-only. Each role gets exactly the permissions it needs.',
  },
  {
    q: 'What languages are supported?',
    a: 'Chat AI natively understands English, French, Mandarin, and Spanish, plus most major world languages via Claude. The assistant detects the language from the first message and replies in kind.',
  },
  {
    q: 'Can I manage multiple stores?',
    a: 'Yes. Connect as many stores as your plan allows, then switch between them mid-chat: "switch to my WooCommerce store" and the assistant follows you over.',
  },
  {
    q: 'What can it change vs. only read?',
    a: 'Shopify and WooCommerce get the full read + write suite (products, inventory, orders, refunds, fulfillment, discounts, POs). Paystack and Flutterwave are read-and-analytics-only — they\'re payments platforms, so there\'s no inventory or discount surface to write to.',
  },
  {
    q: 'How is it priced?',
    a: 'Starter is free with read-only queries and 15 actions/month. Pro (from $69.99/mo) unlocks full write access, reorder forecasting, purchase orders, and multi-store. Scale (from $149.99/mo) adds team roles and unlimited chat quotas. See the full breakdown on the pricing page.',
  },
];

// ---------- Structured data ----------
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Ojunai — AI Commerce Chat Integrations',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web, WhatsApp, Telegram',
  description:
    'AI commerce assistant that connects to Shopify, WooCommerce, Paystack, and Flutterwave — run your whole store by chatting on WhatsApp or Telegram. Ask questions, manage orders and inventory, and forecast reorders in plain language, including voice notes and photos.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    description: 'Starter plan free forever; Pro from $69.99/mo unlocks full write access and forecasting.',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="AI Commerce Chat Integrations — Ojunai"
  description="Connect Shopify, WooCommerce, Paystack, or Flutterwave — then run your whole store from a chat. Ojunai's AI commerce assistant handles orders, inventory, refunds, reorder forecasting, and purchase orders on WhatsApp or Telegram. Text, voice, or photo — in your language."
  canonical="/products/ojunai-inventory/features/ai-commerce-chat-integrations"
  ogImage="/og/features.png"
  jsonLd={[softwareSchema, faqSchema]}
>
  <!-- ============ A. HERO ============ -->
  <section class="ci-hero">
    <div class="ci-hero-glow" aria-hidden="true"></div>
    <div class="container ci-hero-grid">
      <div class="ci-hero-content">
        <nav class="ci-breadcrumb" aria-label="Breadcrumb">
          <a href="/products/ojunai-inventory/features">Features</a>
          <span aria-hidden="true">›</span>
          <span>AI Commerce Chat Integrations</span>
        </nav>
        <h1>Your store, <span class="ci-hero-grad">one message away</span>.</h1>
        <p class="ci-hero-sub">
          Connect Shopify, WooCommerce, Paystack, or Flutterwave — then manage sales, inventory,
          orders, and purchasing right from WhatsApp or Telegram. Ask in plain language. Even by
          voice.
        </p>
        <div class="ci-hero-ctas">
          <a href="https://app.ojunai.com/register" target="_blank" rel="noopener" class="btn-cta-primary btn-cta-primary-xl" data-analytics="ci-hero-primary">
            Connect your store
          </a>
          <a href="#chat-demo" class="btn-secondary-link" data-analytics="ci-hero-see-it">See it in action →</a>
        </div>
        <ul class="ci-trust-row" aria-label="Trust signals">
          <li>Bank-grade encryption</li>
          <li>Confirm-before-change</li>
          <li>Role-based access</li>
        </ul>
      </div>

      <!-- Phone with animated chat thread -->
      <div class="ci-hero-phone" aria-hidden="true">
        <div class="ci-phone">
          <div class="ci-phone-header">
            <span class="ci-phone-dot"></span>
            <span class="ci-phone-title">Ojunai · Assistant</span>
            <span class="ci-phone-status">online</span>
          </div>
          <div class="ci-phone-body">
            <div class="ci-bubble ci-bubble-in ci-anim-in ci-anim-delay-1">
              Good morning! Overnight: 12 orders, $890. Want a full breakdown?
              <span class="ci-time">7:03 AM ✓✓</span>
            </div>
            <div class="ci-bubble ci-bubble-out ci-anim-in ci-anim-delay-2">
              what sold today?
              <span class="ci-time">9:14 AM</span>
            </div>
            <div class="ci-bubble ci-bubble-in ci-anim-in ci-anim-delay-3">
              Today: 42 orders, $3,180 — up 12%.<br>Top: Premium Grey Hoodie (18 units).
              <span class="ci-time">9:14 AM ✓✓</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ B. INTEGRATIONS GRID ============ -->
  <section class="ci-int-section">
    <div class="container">
      <div class="section-header">
        <div class="section-label">Integrations</div>
        <h2>Connect your store, chat where you already are.</h2>
        <p>Two lightweight groups — the platform your store runs on, and the chat channel your team uses.</p>
      </div>

      <div class="ci-int-group">
        <h3 class="ci-int-group-title">Connect your store</h3>
        <div class="ci-int-grid">
          {commerceIntegrations.map((i) => (
            <details class="ci-int-tile" data-analytics={`ci-tile-${i.id}`}>
              <summary>
                <span class="ci-int-logo" style={`background:${i.iconBg};`} aria-hidden="true">{i.letter}</span>
                <span class="ci-int-body">
                  <span class="ci-int-name">
                    {i.name}
                    <span class={`ci-badge ci-badge-${i.status.toLowerCase().replace(/\s+/g,'-')}`}>{i.status}</span>
                  </span>
                  <span class="ci-int-blurb">{i.blurb}</span>
                </span>
                <span class="ci-int-chev" aria-hidden="true">▾</span>
              </summary>
              <ul class="ci-int-caps">
                {i.capabilities.map((c) => <li>{c}</li>)}
              </ul>
            </details>
          ))}
        </div>
      </div>

      <div class="ci-int-group">
        <h3 class="ci-int-group-title">Chat where you already are</h3>
        <div class="ci-int-grid ci-int-grid-2">
          {channelIntegrations.map((i) => (
            <details class="ci-int-tile" data-analytics={`ci-tile-${i.id}`}>
              <summary>
                <span class="ci-int-logo" style={`background:${i.iconBg};`} aria-hidden="true">{i.letter}</span>
                <span class="ci-int-body">
                  <span class="ci-int-name">
                    {i.name}
                    <span class={`ci-badge ci-badge-${i.status.toLowerCase().replace(/\s+/g,'-')}`}>{i.status}</span>
                  </span>
                  <span class="ci-int-blurb">{i.blurb}</span>
                </span>
                <span class="ci-int-chev" aria-hidden="true">▾</span>
              </summary>
              <ul class="ci-int-caps">
                {i.capabilities.map((c) => <li>{c}</li>)}
              </ul>
            </details>
          ))}
        </div>
      </div>

      <!-- Request an integration -->
      <form class="ci-request-tile" data-analytics="ci-request-integration" onsubmit="return handleIntRequest(event)">
        <div class="ci-request-copy">
          <strong>Don't see your platform?</strong>
          <span>Tell us what you need. We prioritize based on demand.</span>
        </div>
        <div class="ci-request-form">
          <input type="text" name="platform" placeholder="e.g. BigCommerce, Squarespace" required aria-label="Platform name" />
          <input type="email" name="email" placeholder="your@email.com" required aria-label="Your email" />
          <button type="submit" class="btn-cta-primary">Request integration →</button>
        </div>
        <p class="ci-request-thanks" hidden>Thanks — we'll let you know when it's ready.</p>
      </form>
    </div>
  </section>

  <!-- ============ C. CAPABILITY PILLARS ============ -->
  <section class="ci-pillars-section">
    <div class="container">
      <div class="section-header">
        <div class="section-label">What you can do</div>
        <h2>Four kinds of superpower.</h2>
        <p>The assistant reads your store, changes it (with your confirmation), and reaches out proactively.</p>
      </div>
      <div class="ci-pillars-grid">
        {pillars.map((p) => (
          <div class="ci-pillar">
            <div class="ci-pillar-icon" aria-hidden="true">
              <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d={p.iconPath} /></svg>
            </div>
            <h3>{p.title}</h3>
            <ul class="ci-pillar-examples">
              {p.examples.map((e) => <li>{e}</li>)}
            </ul>
            {p.note && <p class="ci-pillar-note">{p.note}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ D. LIVE CHAT DEMO ============ -->
  <section class="ci-demo-section" id="chat-demo">
    <div class="container">
      <div class="section-header">
        <div class="section-label">Live sneak peek</div>
        <h2>The chat, for real.</h2>
        <p>Seven real threads — auto-playing. Click a tab to jump.</p>
      </div>

      <div class="ci-demo" aria-label="Chat demo carousel" role="region">
        <div class="ci-demo-tabs" role="tablist" aria-label="Chat scenarios">
