  .legal-entity strong { color: var(--text); }
  .product-legal { scroll-margin-top: 110px; margin: 34px 0; padding: 24px; border: 1px solid var(--border); border-radius: 14px; background: white; }
  .product-legal h2 { margin-top: 0; }
  .product-legal h3, .legal-page h3 { margin: 24px 0 8px; font-size: 1rem; color: var(--text); }
  .product-legal code { padding: 1px 5px; border-radius: 5px; background: var(--bg-alt); }
  .clarification { margin: 20px 0; padding: 18px 20px; border: 1px solid var(--border); border-radius: 12px; background: var(--bg-alt); }
